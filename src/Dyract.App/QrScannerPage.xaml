<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Dyract.App.QrScannerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
    Title="Scan Dyract QR">

    <Grid Padding="16" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
        <Label
            Grid.Row="0"
            Text="Scan a Dyract contact invitation or pairing response. Other QR contents are ignored."
            FontSize="12" />

        <Border Grid.Row="1" StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <zxing:CameraBarcodeReaderView
                x:Name="ScannerView"
                BarcodesDetected="OnBarcodesDetected"
                CameraLocation="Rear"
                IsDetecting="False" />
        </Border>

        <Label
            x:Name="StatusLabel"
            Grid.Row="2"
            FontSize="11"
            Text="Camera is starting…" />

        <Button
            Grid.Row="3"
            Clicked="OnCancelClicked"
            Text="Cancel" />
    </Grid>
</ContentPage>
