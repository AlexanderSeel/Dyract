<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Dyract.App.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:storage="clr-namespace:Dyract.Storage;assembly=Dyract.Storage"
    Title="Dyract">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Label
                FontAttributes="Bold"
                FontSize="34"
                Text="Dyract" />

            <Label
                FontSize="18"
                Text="Direct by design." />

            <Border Padding="16" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" Text="Your identity" />
                    <Label
                        x:Name="PeerIdLabel"
                        FontFamily="monospace"
                        LineBreakMode="CharacterWrap"
                        Text="Creating secure identity…" />
                    <Label
                        x:Name="FingerprintLabel"
                        FontFamily="monospace"
                        FontSize="12"
                        Text="Fingerprint: …" />
                    <HorizontalStackLayout Spacing="10">
                        <Button
                            x:Name="CopyPeerIdButton"
                            Clicked="OnCopyPeerIdClicked"
                            IsEnabled="False"
                            Text="Copy Peer ID" />
                        <Button
                            x:Name="CopyInviteButton"
                            Clicked="OnCopyInviteClicked"
                            IsEnabled="False"
                            Text="Copy invite" />
                    </HorizontalStackLayout>
                    <Button
                        x:Name="ShowInviteQrButton"
                        Clicked="OnShowInviteQrClicked"
                        IsEnabled="False"
                        Text="Show my contact QR" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" Text="Directory" />
                    <Label
                        FontSize="12"
                        Text="Configure the minimal Dyract directory used for identity registration and capability-protected reachability lookup. HTTPS is required." />
                    <Entry
                        x:Name="DirectoryUrlEntry"
                        Keyboard="Url"
                        Placeholder="https://directory.example.com/" />
                    <HorizontalStackLayout Spacing="10">
                        <Button
                            x:Name="SaveDirectoryButton"
                            Clicked="OnSaveDirectoryClicked"
                            IsEnabled="False"
                            Text="Save directory" />
                        <Button
                            x:Name="RegisterDirectoryButton"
                            Clicked="OnRegisterDirectoryClicked"
                            IsEnabled="False"
                            Text="Register identity" />
                    </HorizontalStackLayout>
                    <Label
                        x:Name="DirectoryStatusLabel"
                        FontSize="11"
                        Text="No directory configured." />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" Text="Add or pair contact" />
                    <Label
                        FontSize="12"
                        Text="Scan or paste a dyract://contact invitation to pin a peer identity, or a dyract://pair response from a saved contact to authorize endpoint discovery. Scanning never bypasses verification." />
                    <Editor
                        x:Name="InvitationEditor"
                        AutoSize="TextChanges"
                        HeightRequest="90"
                        Placeholder="dyract://contact/v1/… or dyract://pair/v1/…" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button
                            x:Name="ScanQrButton"
                            Grid.Column="0"
                            Clicked="OnScanQrClicked"
                            IsEnabled="False"
                            Text="Scan QR" />
                        <Button
                            x:Name="AddContactButton"
                            Grid.Column="1"
                            Clicked="OnAddContactClicked"
                            IsEnabled="False"
                            Text="Verify and import" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="Contacts" />

            <Label
                x:Name="NoContactsLabel"
                Text="No contacts yet. Exchange a contact invite with another Dyract installation." />

            <CollectionView
                x:Name="ContactsView"
                SelectionChanged="OnContactSelected"
                SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="storage:LocalContact">
                        <Border Margin="0,4" Padding="14" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label FontAttributes="Bold" FontSize="17" Text="{Binding DisplayName}" />
                                <Label FontFamily="monospace" FontSize="11" Text="{Binding ShortPeerId}" />
                                <Label FontSize="10" Text="{Binding PairingStatus}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label
                x:Name="StatusLabel"
                FontSize="12"
                Text="Initializing…" />

            <Label
                FontSize="11"
                Text="Early development build — messages are stored and queued locally; directory discovery is available, but production P2P delivery is not connected yet." />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
