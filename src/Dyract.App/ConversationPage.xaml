<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Dyract.App.ConversationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="clr-namespace:Dyract.App"
    xmlns:storage="clr-namespace:Dyract.Storage;assembly=Dyract.Storage">

    <Grid Padding="16" RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="12">
        <Border Grid.Row="0" Padding="12" StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="6">
                <Label x:Name="ContactNameLabel" FontAttributes="Bold" FontSize="18" />
                <Label x:Name="ContactPeerIdLabel" FontFamily="monospace" FontSize="10" LineBreakMode="CharacterWrap" />
                <Label x:Name="ContactFingerprintLabel" FontFamily="monospace" FontSize="10" />
                <Label x:Name="PairingStateLabel" FontSize="11" />
                <Label x:Name="IssuedGrantStateLabel" FontSize="11" Text="They do not currently have a tracked reachability grant from you." />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button
                        x:Name="CopyPairingResponseButton"
                        Grid.Column="0"
                        Clicked="OnCopyPairingResponseClicked"
                        IsEnabled="False"
                        Text="Copy pairing response" />
                    <Button
                        x:Name="ShowPairingQrButton"
                        Grid.Column="1"
                        Clicked="OnShowPairingQrClicked"
                        IsEnabled="False"
                        Text="Show pairing QR" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button
                        x:Name="ResolveContactButton"
                        Grid.Column="0"
                        Clicked="OnResolveContactClicked"
                        IsEnabled="False"
                        Text="Check reachability" />
                    <Button
                        x:Name="RevokeMyGrantButton"
                        Grid.Column="1"
                        Clicked="OnRevokeMyGrantClicked"
                        IsEnabled="False"
                        Text="Revoke my grant" />
                </Grid>

                <Label
                    FontSize="10"
                    Text="Their pairing response lets you resolve them. Your pairing response lets them resolve you. Revocation affects only the grant you issued; it does not remove the contact or their grant to you." />
            </VerticalStackLayout>
        </Border>

        <CollectionView
            x:Name="MessagesView"
            Grid.Row="1"
            EmptyView="No messages yet. Messages you send are committed locally before any network delivery is attempted.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="storage:LocalMessage">
                    <Border Margin="0,4" Padding="12" StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                LineBreakMode="WordWrap"
                                Text="{Binding Text}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                FontSize="10"
                                Text="{Binding CreatedAt, StringFormat='{0:HH:mm}'}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="10"
                                Text="{Binding State}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout
            x:Name="PendingAttachmentsSection"
            Grid.Row="2"
            IsVisible="False"
            Spacing="6">
            <Label FontAttributes="Bold" FontSize="13" Text="Pending attachments" />
            <CollectionView
                x:Name="PendingAttachmentsView"
                MaximumHeightRequest="190"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="app:PendingAttachmentView">
                        <Border Margin="0,2" Padding="10" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
                                <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" FontAttributes="Bold" LineBreakMode="TailTruncation" Text="{Binding FileName}" />
                                <Label Grid.Row="1" Grid.Column="0" FontSize="10" Text="{Binding StatusText}" />
                                <Label Grid.Row="2" Grid.Column="0" FontSize="10" Text="{Binding DetailText}" />
                                <Button
                                    Grid.Row="1"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    Clicked="OnRetryAttachmentClicked"
                                    CommandParameter="{Binding .}"
                                    FontSize="11"
                                    Text="Retry" />
                                <Button
                                    Grid.Row="1"
                                    Grid.RowSpan="2"
                                    Grid.Column="2"
                                    Clicked="OnCancelAttachmentClicked"
                                    CommandParameter="{Binding .}"
                                    FontSize="11"
                                    Text="Cancel" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button
                x:Name="AttachButton"
                Grid.Column="0"
                Clicked="OnAttachClicked"
                IsEnabled="False"
                Text="Attach" />
            <Entry
                x:Name="ComposerEntry"
                Grid.Column="1"
                Completed="OnComposerCompleted"
                Placeholder="Message" />
            <Button
                x:Name="SendButton"
                Grid.Column="2"
                Clicked="OnSendClicked"
                IsEnabled="False"
                Text="Send" />
        </Grid>

        <Label
            x:Name="ConversationStatusLabel"
            Grid.Row="4"
            FontSize="11"
            Text="Loading encrypted conversation…" />
    </Grid>
</ContentPage>
