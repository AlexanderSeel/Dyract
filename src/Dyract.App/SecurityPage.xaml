<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Dyract.App.SecurityPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Security &amp; recovery">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Label
                FontAttributes="Bold"
                FontSize="28"
                Text="Security &amp; recovery" />

            <Label
                FontSize="13"
                Text="This screen describes the protection state of this installation. Dyract does not silently create a replacement identity or upload private recovery material to the directory." />

            <Border Padding="16" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label FontAttributes="Bold" Text="Identity" />
                    <Label
                        x:Name="IdentityStatusLabel"
                        FontSize="12" />
                    <Label FontSize="12" Text="Peer ID" />
                    <Label
                        x:Name="PeerIdLabel"
                        FontFamily="monospace"
                        FontSize="12"
                        LineBreakMode="CharacterWrap" />
                    <Label FontSize="12" Text="Security fingerprint" />
                    <Label
                        x:Name="FingerprintLabel"
                        FontFamily="monospace"
                        FontSize="12"
                        LineBreakMode="CharacterWrap" />
                    <Button
                        x:Name="CopyFingerprintButton"
                        Clicked="OnCopyFingerprintClicked"
                        Text="Copy fingerprint" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label FontAttributes="Bold" Text="Identity protection" />
                    <Label Text="Platform SecureStorage: active" />
                    <Label
                        FontSize="12"
                        Text="Android uses the platform SecureStorage/Keystore path and iOS uses Keychain. The current Dyract identity implementation still imports exportable PKCS#8 key material into the app process; hardware-non-exportable identity keys are not implemented yet." />
                    <Label
                        FontSize="12"
                        Text="If an initialized secure identity becomes unreadable, Dyract fails closed instead of silently generating a new Peer ID. You may explicitly reset it below if you accept permanent loss of the old local identity and data." />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label FontAttributes="Bold" Text="Recovery" />
                    <Label FontAttributes="Bold" Text="Recovery configured: No" />
                    <Label
                        FontSize="12"
                        Text="There is currently no Dyract cloud private-key backup, no recovery phrase, and no server-side message-history backup. Losing this device without future recovery material means losing this identity and its local history." />
                    <Label
                        FontSize="12"
                        Text="Encrypted identity export and restore remain unavailable until the recovery container and password-based key derivation design have been independently reviewed." />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label FontAttributes="Bold" Text="Device loss" />
                    <Label
                        FontSize="12"
                        Text="A locked lost device relies primarily on the operating system's device-lock and secure-storage protections. A stolen unlocked, rooted, jailbroken, or otherwise fully controlled device must be treated as an endpoint compromise." />
                    <Label
                        FontSize="12"
                        Text="The current single-device identity has no independent remote-revocation credential. Adding one requires a separately reviewed recovery or multi-device trust design." />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label FontAttributes="Bold" Text="Reset identity and local data" />
                    <Label
                        FontSize="12"
                        Text="Reset permanently removes contacts, conversations, messages, outbox state and stored capabilities, clears the directory configuration, removes both SecureStorage keys, and creates a new Peer ID. Existing contacts will see this as a different identity." />
                    <Label
                        FontSize="12"
                        Text="This is a local reset, not remote revocation of the old identity. If an attacker still controls the old private key, Dyract currently has no independent credential that can disable that identity remotely." />
                    <Label
                        FontSize="12"
                        Text="The reset is explicit and resumable: if the app is interrupted after reset starts, Dyract completes the pending reset before normal identity initialization on the next launch." />
                    <Button
                        x:Name="ResetIdentityButton"
                        Clicked="OnResetIdentityClicked"
                        Text="Reset identity and local data" />
                    <Label
                        x:Name="ResetStatusLabel"
                        FontSize="11" />
                </VerticalStackLayout>
            </Border>

            <Label
                FontSize="11"
                Text="This is implementation status, not an independent mobile secure-storage audit. See docs/device-compromise-recovery.md for the engineering threat analysis." />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
