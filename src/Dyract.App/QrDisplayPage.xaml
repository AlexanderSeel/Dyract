<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Dyract.App.QrDisplayPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label
                x:Name="HeadingLabel"
                FontAttributes="Bold"
                FontSize="24" />

            <Label
                x:Name="ExplanationLabel"
                FontSize="12" />

            <Border
                HorizontalOptions="Center"
                Padding="14"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <zxing:BarcodeGeneratorView
                    x:Name="QrCodeView"
                    CharacterSet="UTF-8"
                    Format="QrCode"
                    HeightRequest="280"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="280" />
            </Border>

            <Label
                FontSize="11"
                Text="Verify the contact fingerprint out-of-band when identity authenticity matters. Pairing QR codes grant temporary reachability permission to the peer they were created for." />

            <Button
                x:Name="CopyButton"
                Clicked="OnCopyClicked"
                Text="Copy value" />

            <Label
                x:Name="StatusLabel"
                FontSize="11" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
